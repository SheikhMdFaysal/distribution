# Copy this file to .env and fill in real values.
# Never commit the real .env file to git.

# ----- Postgres -----
POSTGRES_DB=ai_security
POSTGRES_USER=ai_security
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ----- App config -----
# If you have a domain set up:
ALLOWED_ORIGINS=https://yourdomain.com
PUBLIC_API_URL=https://api.yourdomain.com

# If using droplet IP only (no domain):
# ALLOWED_ORIGINS=http://YOUR_DROPLET_IP
# PUBLIC_API_URL=http://YOUR_DROPLET_IP:8000

# ----- Application secret -----
# Generate a random string:  openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# ----- LLM Provider API Keys (rotate these from your Render keys) -----
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
NVIDIA_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
